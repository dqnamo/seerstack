# Copy to .dev.vars for `pnpm dev`. These point at Tinybird Local (`tb local start`).
TINYBIRD_HOST=http://localhost:7181
# `tb token copy seerstack_ingest` / `tb token copy seerstack_read` after `tb build`
TINYBIRD_INGEST_TOKEN=
TINYBIRD_READ_TOKEN=
ANON_SALT=dev-salt
# Only needed to test the OAuth sign-in locally, with a GitHub OAuth App whose callback is http://localhost:8787/callback
GITHUB_CLIENT_SECRET=
